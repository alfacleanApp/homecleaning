{
  "entities": {
    "userProfile": {
      "title": "UserProfile",
      "description": "User profile representation in Firestore",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "format": "email", "maxLength": 128 },
        "photoURL": { "type": "string", "maxLength": 500 },
        "role": { "type": "string", "enum": ["admin", "supervisor", "cleaner", "customer"] },
        "phone": { "type": "string", "maxLength": 30 },
        "createdAt": { "type": "string", "maxLength": 40 }
      },
      "required": ["uid", "name", "email", "role"]
    },
    "customer": {
      "title": "Customer",
      "description": "Customer account details, wallet, and reward points",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "format": "email", "maxLength": 128 },
        "phone": { "type": "string", "maxLength": 30 },
        "walletBalance": { "type": "number" },
        "points": { "type": "number" },
        "createdAt": { "type": "string", "maxLength": 40 }
      },
      "required": ["id", "name", "email"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "userProfile",
      "description": "User profile collection containing authenticated users"
    },
    "/customers/{customerId}": {
      "schema": "customer",
      "description": "Customer balances, wallets, and rewards"
    }
  }
}
